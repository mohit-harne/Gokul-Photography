---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Scan all event images in src/assets/events
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/{events,event}/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);

const photos = Object.entries(imageModules).map(([filePath, mod]) => {
  const imageObj = mod.default;
  const fileName = filePath.split('/').pop()?.replace(/\.[^/.]+$/, '') || '';
  const caption = fileName
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());

  return {
    image: imageObj,
    fullSrc: imageObj.src,
    caption,
    width: imageObj.width,
    height: imageObj.height,
  };
});
---

<Layout title="Event Photography | Gokul Photography Studio">
  <!-- Header Banner -->
  <section class="pt-32 sm:pt-36 pb-12 sm:pb-16 px-5 sm:px-12 text-center max-w-4xl mx-auto space-y-3 sm:space-y-4">
    <p class="text-[11px] sm:text-xs tracking-[0.3em] text-neutral-400 uppercase font-light">Gallery</p>
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-serif text-white tracking-wide">
      Events &amp; Gatherings
    </h1>
    <p class="text-xs sm:text-sm text-neutral-400 font-light max-w-xl mx-auto leading-relaxed pt-1 sm:pt-2 px-4">
      Corporate summits, cultural festivals, and private ceremonies documented with cinematic precision.
    </p>
  </section>

  <!-- Responsive Masonry Grid -->
  <section class="px-4 sm:px-8 md:px-12 pb-24 max-w-7xl mx-auto">
    {photos.length === 0 ? (
      <div class="text-center py-20 border border-neutral-800 bg-neutral-900/30 p-8">
        <p class="text-neutral-400 text-sm">No images found in <code class="text-neutral-200">src/assets/events/</code>.</p>
        <p class="text-xs text-neutral-500 mt-2">Add your event photos to that folder to see them load here.</p>
      </div>
    ) : (
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-5 space-y-5">
        {photos.map((item) => (
          <div 
            class="relative group overflow-hidden bg-neutral-900/80 break-inside-avoid rounded-none cursor-pointer skeleton-wrapper"
            style={`aspect-ratio: ${item.width} / ${item.height};`}
          >
            <!-- Animated Skeleton Shimmer -->
            <div class="skeleton-shimmer absolute inset-0 z-0 bg-neutral-900 overflow-hidden pointer-events-none">
              <div class="w-full h-full bg-gradient-to-r from-transparent via-neutral-800/60 to-transparent -translate-x-full animate-[shimmer_1.8s_infinite]"></div>
            </div>

            <!-- Optimized Grid Image -->
            <Image
              src={item.image}
              alt={item.caption}
              width={800}
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
              data-full={item.fullSrc}
              data-caption={item.caption}
              class="lightbox-trigger relative z-10 w-full h-auto object-cover opacity-0 transition-all duration-700 ease-out group-hover:scale-105"
              onload="this.classList.remove('opacity-0'); this.closest('.skeleton-wrapper')?.querySelector('.skeleton-shimmer')?.remove();"
            />

            <!-- Editorial Hover Overlay -->
            <div class="absolute inset-0 z-20 bg-gradient-to-t from-black/85 via-black/25 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5 pointer-events-none">
              <span class="text-white text-xs font-serif tracking-wider uppercase font-light">
                {item.caption}
              </span>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- Lightbox Mount -->
  <Lightbox />
</Layout>

<style>
  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
</style>

<script>
  document.querySelectorAll('img.lightbox-trigger').forEach((img) => {
    const htmlImg = img as HTMLImageElement;
    if (htmlImg.complete) {
      htmlImg.classList.remove('opacity-0');
      htmlImg.closest('.skeleton-wrapper')?.querySelector('.skeleton-shimmer')?.remove();
    }
  });
</script>