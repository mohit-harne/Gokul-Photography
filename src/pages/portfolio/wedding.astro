---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';

// Scan all images in public/wedding automatically using Vite
const imageModules = import.meta.glob('/public/wedding/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', {
  eager: true,
  query: '?url',
  import: 'default',
});

// Format image list and generate clean captions from file names
const photos = Object.keys(imageModules).map((filePath) => {
  // Convert "/public/wedding/photo.jpg" -> "/wedding/photo.jpg" (browser route)
  const url = filePath.replace('/public', '');

  // Extract filename without extension (e.g. "pooja-rohan-vows" -> "Pooja Rohan Vows")
  const fileName = filePath.split('/').pop()?.replace(/\.[^/.]+$/, '') || '';
  const caption = fileName.replace(/[-_]/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());

  return {
    url,
    caption,
  };
});
---

<Layout title="Wedding Photography | Gokul Photography Studio">
  <!-- Header Banner -->
  <section class="pt-32 sm:pt-36 pb-12 sm:pb-16 px-5 sm:px-12 text-center max-w-4xl mx-auto space-y-3 sm:space-y-4">
    <p class="text-[11px] sm:text-xs tracking-[0.3em] text-neutral-400 uppercase font-light">Gallery</p>
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-serif text-white tracking-wide">
      Weddings & Elopements
    </h1>
    <p class="text-xs sm:text-sm text-neutral-400 font-light max-w-xl mx-auto leading-relaxed pt-1 sm:pt-2 px-4">
      Intimate vows, timeless portraits, and honest unscripted documentary moments captured across India.
    </p>
  </section>

  <!-- Responsive Masonry Grid -->
  <section class="px-4 sm:px-8 md:px-12 pb-24 max-w-7xl mx-auto">
    {photos.length === 0 ? (
      <div class="text-center py-20 border border-neutral-800 bg-neutral-900/30 p-8">
        <p class="text-neutral-400 text-sm">No images found in <code class="text-neutral-200">public/wedding/</code>.</p>
        <p class="text-xs text-neutral-500 mt-2">Add your .jpg, .png, or .webp images to that folder to see them here.</p>
      </div>
    ) : (
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-5 space-y-5">
        {photos.map((item) => (
          <div class="relative group overflow-hidden bg-neutral-900 break-inside-avoid rounded-none cursor-pointer">
            <img
              src={item.url}
              alt={item.caption}
              data-full={item.url}
              data-caption={item.caption}
              loading="lazy"
              class="lightbox-trigger w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <!-- Editorial Hover Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-5 pointer-events-none">
              <span class="text-white text-xs font-serif tracking-wider uppercase font-light">
                {item.caption}
              </span>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- Lightbox Mount -->
  <Lightbox />
</Layout>