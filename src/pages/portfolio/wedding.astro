---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';

const photos = [
  {
    url: "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80",
    caption: "Pooja & Rohan — Sunset Rituals, Udaipur",
    heightClass: "h-96"
  },
  {
    url: "https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=1200&q=80",
    caption: "The Bridal Veil — Leela Palace",
    heightClass: "h-64"
  },
  {
    url: "https://images.unsplash.com/photo-1606800052052-a08af7148866?auto=format&fit=crop&w=1200&q=80",
    caption: "Exchanging Vows in Goa",
    heightClass: "h-80"
  },
  {
    url: "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1200&q=80",
    caption: "Sangeet Night Confetti Dance",
    heightClass: "h-72"
  },
  {
    url: "https://images.unsplash.com/photo-1532712938310-34cb3982ef74?auto=format&fit=crop&w=1200&q=80",
    caption: "Mehendi Details & Heirloom Jewels",
    heightClass: "h-96"
  },
  {
    url: "https://images.unsplash.com/photo-1545232979-8bf68ee9b1af?auto=format&fit=crop&w=1200&q=80",
    caption: "First Walk as Partners",
    heightClass: "h-80"
  },
];
---

<Layout title="Wedding Photography | Imagination Studio">
  <!-- Header Banner -->
  <section class="pt-36 pb-16 px-6 md:px-12 text-center max-w-4xl mx-auto space-y-4">
    <p class="text-xs tracking-[0.3em] text-neutral-400 uppercase font-light">Gallery</p>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif text-white tracking-wide">
      Weddings & Elopements
    </h1>
    <p class="text-sm text-neutral-400 font-light max-w-xl mx-auto leading-relaxed pt-2">
      Intimate vows, timeless portraits, and honest unscripted documentary moments captured across India.
    </p>
  </section>

  <!-- Responsive Masonry Grid -->
  <section class="px-4 md:px-12 pb-24 max-w-7xl mx-auto">
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
      {photos.map((item) => (
        <div class="relative group overflow-hidden bg-neutral-900 break-inside-avoid rounded-sm cursor-pointer">
          <img
            src={item.url}
            alt={item.caption}
            data-full={item.url}
            data-caption={item.caption}
            loading="lazy"
            class="lightbox-trigger w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          />
          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6 pointer-events-none">
            <span class="text-white text-xs font-serif tracking-wider uppercase font-light">
              {item.caption}
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Lightbox Mount -->
  <Lightbox />
</Layout>