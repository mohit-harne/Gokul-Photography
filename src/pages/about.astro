---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ownerImg from '../assets/owner.png';
---

<Layout title="About Us | Imagination Studio">
  <!-- Hero Banner -->
  <section class="pt-36 pb-16 px-6 md:px-12 text-center max-w-4xl mx-auto space-y-4">
    <p class="text-xs tracking-[0.3em] text-neutral-400 uppercase font-light">Behind The Lens</p>
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif text-white tracking-wide">
      The Collective
    </h1>
  </section>

  <!-- Founder Bio Split Section -->
  <section class="max-w-6xl mx-auto px-6 md:px-12 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div class="relative">
        <Image
  src={ownerImg}
  alt="Lead photographer portrait"
  class="w-full h-[520px] object-cover rounded-sm grayscale contrast-125"
/>
        <div class="absolute -bottom-4 -right-4 w-full h-full border border-neutral-800 -z-10 hidden sm:block"></div>
      </div>

      <div class="space-y-6 text-left">
        <span class="text-xs tracking-[0.25em] text-neutral-400 uppercase">Director & Lead Visualist</span>
        <h2 class="text-3xl sm:text-4xl font-serif text-white font-normal leading-snug">
          "We view weddings not as productions to be posed, but as living stories to be preserved."
        </h2>
        <p class="text-neutral-400 text-sm font-light leading-relaxed">
          Imagination Studio was founded with a singular purpose: documenting the human condition in its most raw, joyful, and unguarded state. We do away with stiff stage cues in favor of quiet observation.
        </p>
        <p class="text-neutral-400 text-sm font-light leading-relaxed">
          Based out of Maharashtra and traveling worldwide, our team combines documentary street-style intuition with high-fashion lighting and color grading inspired by 35mm celluloid.
        </p>
        <div class="pt-4 grid grid-cols-3 gap-4 border-t border-neutral-800 text-center">
          <div>
            <p class="text-2xl font-serif text-white">8+</p>
            <p class="text-[10px] tracking-widest text-neutral-400 uppercase mt-1">Years Active</p>
          </div>
          <div>
            <p class="text-2xl font-serif text-white">250+</p>
            <p class="text-[10px] tracking-widest text-neutral-400 uppercase mt-1">Weddings</p>
          </div>
          <div>
            <p class="text-2xl font-serif text-white">14</p>
            <p class="text-[10px] tracking-widest text-neutral-400 uppercase mt-1">Destinations</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Philosophy Section -->
  <section class="bg-neutral-900/60 border-y border-neutral-800/80 py-20 px-6 md:px-12">
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <p class="text-xs tracking-[0.25em] text-neutral-400 uppercase font-light">Our Approach</p>
      <h3 class="text-2xl sm:text-3xl font-serif text-neutral-200 font-light leading-relaxed">
        Unscripted. Emotional. Cinematic.
      </h3>
      <p class="text-neutral-400 text-sm font-light leading-loose max-w-2xl mx-auto">
        When you look back on your wedding imagery ten years from now, you shouldn’t just see what you looked like—you should remember exactly how that evening felt.
      </p>
    </div>
  </section>
</Layout>