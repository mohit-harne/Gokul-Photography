---
import Layout from '../layouts/Layout.astro';

const films = [
  {
    id: "2ib3KfJI3bs",
    title: "Echoes of Udaipur — Rhea & Kabir",
    location: "The Oberoi Udaivilas, Udaipur",
    tagline: "Royal Heritage & Palace Courtyard Vows",
    duration: "4:48",
    year: "2025"
  },
  {
    id: "aIEv4MzK-xE",
    title: "Sands & Salt Air — Tanisha & Arman",
    location: "Ashvem Beach, Goa",
    tagline: "Sunset Coastal Nuptials",
    duration: "5:14",
    year: "2025"
  },
  {
    id: "yj9RdAPEMYs",
    title: "A Fort Lit in Gold — Sanjana & Neil",
    location: "Suryagarh, Jaisalmer",
    tagline: "Desert Fortresses & Amber Lanterns",
    duration: "6:05",
    year: "2025"
  },
  {
    id: "JfcNMmptY48",
    title: "Mist & Wild Orchids — Ananya & Dev",
    location: "Windflower Hall, Shimla",
    tagline: "Pine Forest Reverie & Alpine Whispers",
    duration: "5:42",
    year: "2024"
  },
  {
    id: "m0_Hmj-QB30",
    title: "The Backwater Vows — Meera & Siddharth",
    location: "Kumarakom, Kerala",
    tagline: "Tranquil Canals & Traditional Temple Rites",
    duration: "7:12",
    year: "2024"
  },
  {
    id: "MQhZ2ydj9E0",
    title: "Crimson Haveli — Diya & Aarav",
    location: "Samode Palace, Jaipur",
    tagline: "Fresco Walls & Twilight Fireworks",
    duration: "4:30",
    year: "2024"
  }
];

// Generates looping, muted background preview streams that satisfy browser autoplay policies
function getYouTubeBackgroundUrl(videoId: string) {
  return `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${videoId}&playsinline=1&rel=0&modestbranding=1&enablejsapi=1`;
}
---

<Layout title="Cinematic Wedding Films | Gokul Photography Studio">
  <!-- Editorial Page Intro -->
  <section class="pt-36 sm:pt-44 pb-14 px-6 md:px-12 text-center max-w-4xl mx-auto space-y-4">
    <div class="flex items-center justify-center gap-3">
      <span class="h-px w-8 bg-amber-200/40"></span>
      <p class="text-[10px] tracking-[0.35em] text-neutral-400 uppercase font-light">Cinema Portfolio</p>
      <span class="h-px w-8 bg-amber-200/40"></span>
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif text-white tracking-wide font-light">
      Cinematic <span class="italic font-normal text-amber-100/90">Wedding</span> Films
    </h1>

    <p class="text-xs sm:text-sm text-neutral-400 font-light max-w-xl mx-auto leading-relaxed pt-1">
      Motion, sound, and authentic dialogue woven into timeless cinematic heirlooms across India and beyond.
    </p>

    <div class="pt-4 flex justify-center items-center gap-2 text-neutral-600">
      <div class="w-1.5 h-1.5 rotate-45 border border-amber-200/40"></div>
    </div>
  </section>

  <!-- Spotlight Feature Film: Hero Autoplay Showcase -->
  <section class="max-w-6xl mx-auto px-4 sm:px-8 md:px-12 pb-20">
    <div 
      class="film-card group relative aspect-video sm:aspect-21/9 w-full overflow-hidden rounded-none bg-neutral-950 border border-neutral-800/90 shadow-2xl cursor-pointer"
      data-video-id={films[0].id}
      data-title={films[0].title}
    >
      <!-- Background Autoplaying Iframe -->
      <iframe
        src={getYouTubeBackgroundUrl(films[0].id)}
        title={films[0].title}
        class="absolute inset-0 w-full h-full pointer-events-none scale-105 opacity-90 transition-transform duration-1000 group-hover:scale-110"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        loading="eager"
      ></iframe>

      <!-- Cinematic Vignette & Bottom Scrim -->
      <div 
        class="absolute inset-0 pointer-events-none" 
        style="background: linear-gradient(to top, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.4) 40%, rgba(10,10,10,0.2) 100%);"
      ></div>

      <!-- Architectural Accent Frame -->
      <div class="absolute inset-4 sm:inset-6 pointer-events-none border border-amber-200/0 group-hover:border-amber-200/30 transition-all duration-700"></div>

      <!-- Play Trigger Pill -->
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border border-white/30 backdrop-blur-md bg-black/40 flex items-center justify-center text-white/90 group-hover:scale-110 group-hover:bg-amber-100 group-hover:text-black group-hover:border-amber-200 transition-all duration-500 shadow-2xl">
          <svg class="w-6 h-6 sm:w-7 sm:h-7 fill-current translate-x-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
      </div>

      <!-- Hero Captions & Tagline -->
      <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4 pointer-events-none">
        <div class="space-y-1.5 max-w-xl">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span class="text-[10px] tracking-[0.25em] text-amber-200/90 uppercase font-mono">Spotlight Premiere</span>
            <span class="text-neutral-500 font-mono text-xs">·</span>
            <span class="text-neutral-400 text-xs font-mono">{films[0].year}</span>
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-white font-light tracking-wide">{films[0].title}</h2>
          <p class="text-xs text-neutral-400 font-light">{films[0].location} — <span class="italic text-neutral-300">{films[0].tagline}</span></p>
        </div>
        <span class="text-[10px] tracking-[0.25em] text-neutral-300 font-mono px-3 py-1 bg-black/60 border border-neutral-800 backdrop-blur-sm self-start sm:self-auto">
          {films[0].duration}
        </span>
      </div>
    </div>
  </section>

  <!-- Curated Catalog Section: Autoplaying Grid Cards -->
  <section class="max-w-6xl mx-auto px-4 sm:px-8 md:px-12 pb-32">
    <div class="flex items-center justify-between pb-8 border-b border-neutral-900">
      <div>
        <p class="text-[10px] tracking-[0.3em] uppercase text-neutral-400 font-light">Archive Catalog</p>
        <h3 class="text-xl sm:text-2xl font-serif text-white tracking-wide mt-1">Select Film Works</h3>
      </div>
      <span class="text-xs font-mono text-neutral-500">0{films.length - 1} Pieces</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10 pt-10">
      {films.slice(1).map((film, index) => (
        <article 
          class="film-card group cursor-pointer space-y-4 opacity-0 translate-y-12 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
          data-video-id={film.id}
          data-title={film.title}
          style={`transition-delay: ${index * 120}ms;`}
        >
          <!-- Video Container with Autoplaying Iframe -->
          <div class="relative aspect-video overflow-hidden rounded-none bg-neutral-950 border border-neutral-900 shadow-xl">
            <!-- Autoplaying Video -->
            <iframe
              src={getYouTubeBackgroundUrl(film.id)}
              title={film.title}
              class="absolute inset-0 w-full h-full pointer-events-none scale-105 opacity-85 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700 ease-out"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              loading="lazy"
            ></iframe>

            <!-- Subtle Vignette Overlay -->
            <div class="absolute inset-0 pointer-events-none bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

            <!-- Architectural Inner Frame -->
            <div class="absolute inset-3 z-20 pointer-events-none border border-amber-200/0 group-hover:border-amber-200/30 transition-all duration-500 scale-95 group-hover:scale-100"></div>

            <!-- Monospace Index Badge -->
            <span class="absolute top-3 left-3 z-20 text-[9px] tracking-[0.25em] font-mono text-neutral-300 bg-black/70 px-2 py-0.5 border border-white/10 backdrop-blur-sm">
              № 0{index + 2}
            </span>

            <!-- Duration Badge -->
            <span class="absolute bottom-3 right-3 z-20 text-[10px] tracking-widest font-mono text-neutral-300 bg-black/80 px-2 py-1 border border-neutral-800 backdrop-blur-sm">
              {film.duration}
            </span>

            <!-- Circular Play Button (Click to Open Theater Modal with Audio) -->
            <div class="absolute inset-0 z-20 flex items-center justify-center pointer-events-none">
              <div class="w-12 h-12 rounded-full border border-white/40 bg-black/40 backdrop-blur-sm flex items-center justify-center text-white group-hover:scale-110 group-hover:bg-amber-100 group-hover:text-black group-hover:border-amber-200 transition-all duration-300 shadow-lg">
                <svg class="w-4 h-4 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Metadata -->
          <div class="space-y-1">
            <div class="flex items-center justify-between text-[11px] tracking-[0.2em] uppercase text-neutral-400 font-light">
              <span>{film.location}</span>
              <span class="font-mono text-neutral-500">{film.year}</span>
            </div>
            <h3 class="text-xl font-serif text-white font-light group-hover:text-amber-100/90 transition-colors">
              {film.title}
            </h3>
            <p class="text-xs text-neutral-500 font-light italic">
              {film.tagline}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Cinema Theater Lightbox Modal -->
  <div
    id="cinema-modal"
    class="fixed inset-0 z-[200] bg-neutral-950/98 backdrop-blur-2xl flex flex-col items-center justify-center p-4 sm:p-8 md:p-12 opacity-0 pointer-events-none transition-all duration-500"
    role="dialog"
    aria-modal="true"
    aria-label="Cinema Player"
  >
    <!-- Modal Header Controls -->
    <div class="w-full max-w-5xl flex items-center justify-between pb-3 sm:pb-4 px-1">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span id="modal-film-title" class="text-xs sm:text-sm font-serif text-neutral-200 tracking-wider font-light"></span>
      </div>

      <div class="flex items-center gap-3">
        <!-- Fullscreen Button -->
        <button
          id="modal-fullscreen-btn"
          type="button"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-neutral-800 bg-neutral-900/60 hover:bg-neutral-800 hover:text-amber-200 text-neutral-300 flex items-center justify-center transition-colors cursor-pointer"
          title="Toggle Fullscreen"
          aria-label="Toggle Fullscreen"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
          </svg>
        </button>

        <!-- Close Modal Button -->
        <button
          id="close-cinema-modal"
          type="button"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-neutral-800 bg-neutral-900/60 hover:bg-white hover:text-black text-neutral-300 flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Close modal"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Active Theater Screen Container -->
    <div
      id="cinema-player-box"
      class="relative w-full max-w-5xl aspect-video bg-black border border-neutral-800 shadow-2xl overflow-hidden transform scale-95 transition-transform duration-500"
    >
      <iframe
        id="cinema-iframe"
        class="w-full h-full"
        src=""
        title="Cinematic Wedding Film"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <!-- Bottom Helper Note -->
    <div class="pt-4 text-center">
      <p class="text-[10px] tracking-[0.25em] text-neutral-500 uppercase">Press Esc to exit cinema view</p>
    </div>
  </div>
</Layout>

<style>
  .film-card.revealed {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>

<script>
  function setupCinemaPage() {
    const cards = document.querySelectorAll<HTMLElement>('.film-card');
    const modal = document.getElementById('cinema-modal');
    const modalBox = document.getElementById('cinema-player-box');
    const modalIframe = document.getElementById('cinema-iframe') as HTMLIFrameElement | null;
    const modalTitle = document.getElementById('modal-film-title');
    const closeBtn = document.getElementById('close-cinema-modal');
    const fullscreenBtn = document.getElementById('modal-fullscreen-btn');

    // Reveal animations on scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -40px 0px', threshold: 0.1 }
    );

    cards.forEach((card) => observer.observe(card));

    // Open lightbox with audio enabled on click
    function openCinema(videoId: string, title: string) {
      if (!modal || !modalIframe || !modalBox) return;

      modalIframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&mute=0&controls=1&rel=0&modestbranding=1&playsinline=1&enablejsapi=1`;
      
      if (modalTitle) modalTitle.textContent = title;

      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');

      requestAnimationFrame(() => {
        modalBox.classList.remove('scale-95');
        modalBox.classList.add('scale-100');
      });

      document.documentElement.classList.add('overflow-hidden');
      document.body.classList.add('overflow-hidden', 'touch-none');
    }

    function closeCinema() {
      if (!modal || !modalIframe || !modalBox) return;

      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modalBox.classList.add('scale-95');
      modalBox.classList.remove('scale-100');

      setTimeout(() => {
        modalIframe.src = '';
      }, 300);

      document.documentElement.classList.remove('overflow-hidden');
      document.body.classList.remove('overflow-hidden', 'touch-none');

      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-video-id');
        const title = card.getAttribute('data-title') || 'Wedding Film';
        if (id) openCinema(id, title);
      });
    });

    closeBtn?.addEventListener('click', closeCinema);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeCinema();
    });

    fullscreenBtn?.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        modalBox?.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('pointer-events-none')) {
        closeCinema();
      }
    });
  }

  setupCinemaPage();
  document.addEventListener('astro:page-load', setupCinemaPage);
</script>