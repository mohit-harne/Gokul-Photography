---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import story1 from '../assets/stories/stories (1).jpg';
import story2 from '../assets/stories/stories (2).jpg';
import story3 from '../assets/stories/stories (3).jpg';
import Wedding5 from '../assets/wedding/Wedding (5).jpg';
import Prewedding8 from '../assets/pre_wedding/Pre-wedding (8).jpg';
// Portfolio highlights
const portfolioCategories = [
  {
    title: "Weddings",
    subtitle: "Ceremonies & Celebrations",
    image: Wedding5,
    link: "/portfolio/weddings",
  },
  {
    title: "Pre-Weddings",
    subtitle: "Intimate Engagements",
    image: Prewedding8,
    link: "/portfolio/pre-weddings",
  }
];

// Latest Stories
const latestStories = [
  {
    couple: "Divya & Kashyap",
    location: "Nagpur",
    category: "Wedding",
    image: story1,
    link: "/stories/divya-kashyap",
  },
  {
    couple: "Vrushali & Pruthviraj",
    location: "Pune",
    category: "Royal Wedding",
    image: story2,
    link: "/stories/vrushali-pruthviraj",
  },
  {
    couple: "Tushar & Srishti",
    location: "Mumbai",
    category: "Destination Wedding",
    image: story3,
    link: "/stories/tushar-srishti",
  }
];

// Featured Films
const featuredFilms = [
  {
    tag: "Lovebirds",
    couple: "Pratik & Shrusti",
    event: "Wedding Film",
    description: "A love marriage is a beautiful union where two individuals choose each other based on mutual affection, deep friendship, and understanding.",
    thumbnail: "https://images.unsplash.com/photo-1544078751-58fee2d8a03b?auto=format&fit=crop&w=1200&q=80",
    videoId: "1t32XVVVCFw", // Extract just the ID from https://www.youtube.com/watch?v=...
  },
  {
    tag: "Soulmates",
    couple: "Ankit & Aporva",
    event: "Wedding Film",
    description: "Love is the expansion of two natures in such fashion that each includes the other, and each is enriched by the other.",
    thumbnail: "https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1200&q=80",
    videoId: "qU92sQZbnpk", // Leave blank or add an ID
  }
];

// Experience / Visual Gallery


const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/landing-page-gallery/*.jpg');
---

<Layout>
  <!-- Full Screen Hero Section -->
  <section class="relative h-screen w-full flex items-center justify-center overflow-hidden">
    <!-- Background Video with Vignette Overlay -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <video
        autoplay
        loop
        muted
        playsinline
        class="w-full h-full object-cover object-center"
      >
        <!-- Replace 'hero-video.mp4' with your exact video filename in public/ -->
        <source src="/hero-video.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>

      <!-- Overlay gradient for text readability -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/35 to-neutral-950"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto space-y-6">
     <p class="text-xs md:text-sm tracking-[0.35em] text-neutral-300 uppercase font-light">
  Cinematic Wedding Films & Photography
</p>
<h1 class="text-3xl sm:text-5xl md:text-6xl font-serif font-light text-white leading-tight">
  Your <span class="font-['Alex_Brush'] text-5xl sm:text-7xl md:text-8xl text-amber-100/90 font-normal capitalize inline-block px-1">love story</span>, framed by Gokul Studios
</h1>
      <div class="pt-4">
        <a
          href="/portfolio"
          class="inline-block border border-white/60 hover:border-white text-white px-8 py-3 text-xs tracking-[0.25em] uppercase hover:bg-white hover:text-black transition-all duration-300"
        >
          View Portfolio
        </a>
      </div>
    </div>

    <!-- Animated Scroll Down Arrow -->
    <a
      href="#philosophy"
      aria-label="Scroll to content"
      class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 group text-white/70 hover:text-white transition-colors duration-300"
    >
      <span class="text-[10px] tracking-[0.3em] uppercase opacity-75 group-hover:opacity-100 transition-opacity">
        Scroll
      </span>
      <div class="animate-bounce">
        <svg
          class="w-5 h-5 text-white/80"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </div>
    </a>
  </section>

  <!-- Quote & Philosophy Section -->
  <section id="philosophy" class="py-24 sm:py-32 px-6 md:px-12 max-w-5xl mx-auto text-center space-y-8">
    <span class="text-xs uppercase tracking-[0.35em] text-neutral-400">Our Philosophy</span>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif italic text-neutral-100 font-light leading-relaxed">
      "We call ourselves a collective because we truly believe the best elopements and weddings are a group effort, and that group includes our couples."
    </h2>
    <p class="text-sm sm:text-base text-neutral-400 max-w-2xl mx-auto font-light leading-loose">
      From location and light, to timing and style, our team works together with couples to give them the creative control to envision their day and the guidance to bring that vision to life.
    </p>
  </section>

  <!-- Category Showcase: Telling Your Story -->
  <section class="py-16 px-6 md:px-12 max-w-7xl mx-auto">
    <div class="text-center mb-16 space-y-3">
      <span class="text-xs uppercase tracking-[0.3em] text-neutral-400">Portfolio</span>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-serif font-light text-white tracking-wide uppercase">
        Telling Your Story Through Beautiful Imagery
      </h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {portfolioCategories.map((item) => (
        <a
          href={item.link}
          class="group relative h-[420px] sm:h-[500px] overflow-hidden block border border-neutral-800/80 bg-neutral-900"
        >
          <Image
          width={600}
  height={800}
            src={item.image}
            alt={item.title}
            loading="lazy"
            class="w-full h-full object-cover object-center grayscale-[20%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent group-hover:from-black/90 transition-all duration-300" />
          <div class="absolute bottom-0 left-0 right-0 p-8 sm:p-10 text-center transform transition-transform duration-300">
            <p class="text-xs tracking-[0.25em] uppercase text-neutral-300 font-light mb-2">
              {item.subtitle}
            </p>
            <h4 class="text-3xl sm:text-4xl font-serif text-white uppercase tracking-wider mb-4">
              {item.title}
            </h4>
            <span class="inline-block text-xs uppercase tracking-[0.25em] text-white border-b border-white/60 pb-1 group-hover:border-white transition-all">
              Explore Collection &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Stories Section: The Latest On The Blog/Couples -->
  <section class="py-24 px-6 md:px-12 max-w-7xl mx-auto border-t border-neutral-900">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="space-y-3">
        <span class="text-xs uppercase tracking-[0.3em] text-neutral-400">Journal & Stories</span>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-serif font-light text-white">
          The Latest Stories
        </h3>
      </div>
      <a
        href="/stories"
        class="text-xs uppercase tracking-[0.25em] text-neutral-300 hover:text-white border-b border-neutral-700 hover:border-white pb-1 w-fit transition-colors"
      >
        View All Stories &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {latestStories.map((story) => (
        <article class="group space-y-4">
          <a href={story.link} class="block overflow-hidden h-80 sm:h-96 relative bg-neutral-900 border border-neutral-800/80">
            <Image
              src={story.image}
              alt={story.couple}
              width={800}
  height={600}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-sm px-3 py-1 text-[10px] uppercase tracking-widest text-neutral-200">
              {story.category}
            </div>
          </a>
          <div class="space-y-1">
            <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-500 font-light">
              {story.location}
            </span>
            <h4 class="text-xl font-serif text-neutral-100 group-hover:text-white transition-colors">
              <a href={story.link}>{story.couple}</a>
            </h4>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Featured Films Section -->
  <section class="py-24 px-6 md:px-12 bg-neutral-950/70 border-y border-neutral-900">
    <div class="max-w-7xl mx-auto space-y-16">
      <div class="text-center space-y-3">
        <span class="text-xs uppercase tracking-[0.3em] text-neutral-400">Cinema</span>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-serif font-light text-white">
          From The Films
        </h3>
      </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
  {featuredFilms.map((film) => (
    <div class="space-y-6 flex flex-col justify-between">
      <div class="relative aspect-video overflow-hidden border border-neutral-800 bg-neutral-900 pointer-events-none select-none">
        {film.videoId ? (
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${film.videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${film.videoId}&playsinline=1&rel=0&showinfo=0&modestbranding=1&disablekb=1&fs=0`}
            title={film.couple}
            allow="autoplay; encrypted-media; picture-in-picture"
            tabindex="-1"
            class="w-full h-full object-cover scale-[1.05]"
          ></iframe>
        ) : (
          <Image
            src={film.thumbnail}
            alt={film.couple}
            class="w-full h-full object-cover"
            width={800}
            height={600}
          />
        )}
      </div>

      <div class="space-y-3">
        <div class="flex items-center gap-3">
          <span class="text-xs uppercase tracking-[0.25em] text-neutral-400 font-light">
            "{film.tag}"
          </span>
          <span class="text-neutral-600">&bull;</span>
          <span class="text-xs uppercase tracking-[0.2em] text-neutral-500">
            {film.event}
          </span>
        </div>
        <h4 class="text-2xl font-serif text-white font-normal">
          {film.couple}
        </h4>
        <p class="text-sm text-neutral-400 font-light leading-relaxed">
          {film.description}
        </p>
      </div>
    </div>
  ))}
</div>
    </div>
  </section>

  <!-- Photo Grid Experience / "A Picture is Worth a Thousand Words" -->
  <section class="py-24 px-6 md:px-12 max-w-7xl mx-auto space-y-12">
    <div class="text-center space-y-3">
      <span class="text-xs uppercase tracking-[0.3em] text-neutral-400">Experience</span>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-serif font-light text-white uppercase tracking-wider">
        A picture is worth a thousand words
      </h3>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
  {Object.values(images).map(async (imagePromise, index) => {
    const Imageitem = await imagePromise();
    return (
      <div class="overflow-hidden aspect-[3/4] bg-neutral-900 border border-neutral-800/80">
        <Image
        width={800}
  height={600}
          src={Imageitem.default}
          alt={`Wedding moment ${index + 1}`}
          loading="lazy"
          class="w-full h-full object-cover hover:scale-110 transition-transform duration-700 ease-out"
        />
      </div>
    );
  })}
</div>
  </section>

  <!-- Big Statement & Call To Action -->
  <section class="py-24 px-6 md:px-12 text-center bg-gradient-to-b from-transparent via-neutral-950/80 to-black border-t border-neutral-900 space-y-8">
    <div class="max-w-3xl mx-auto space-y-6">
      <p class="text-xs uppercase tracking-[0.35em] text-neutral-400">Commitment</p>
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-serif text-white tracking-wide uppercase leading-tight">
        Do. Everything. In Love.
      </h2>
      <p class="text-sm sm:text-base text-neutral-400 max-w-xl mx-auto font-light leading-relaxed">
        Let us preserve your precious, once-in-a-lifetime moments into timeless cinematic films and photographs.
      </p>
      <div class="pt-4">
        <a
          href="/contact"
          class="inline-block border border-white text-white px-10 py-3.5 text-xs tracking-[0.25em] uppercase hover:bg-white hover:text-black transition-all duration-300"
        >
          Inquire Now
        </a>
      </div>
    </div>
  </section>
</Layout>