---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { portfolioCategories, latestStories, featuredFilms, assets } from '../data/mediaData';
import Reel1 from "../assets/reels/Reel1.mp4";
import Reel2 from "../assets/reels/Reel2.mp4";
import Reel3 from "../assets/reels/Reel3.mp4";
import Reel4 from "../assets/reels/Reel4.mp4";
import Reel5 from "../assets/reels/Reel5.mp4";
import ReelsCoverflow from '../components/ReelsCoverflow';
import Reel1poster from "../assets/reels/Reel1poster.png";
import Reel2poster from "../assets/reels/Reel2poster.png";
import Reel3poster from "../assets/reels/Reel3poster.png";
import Reel4poster from "../assets/reels/Reel4poster.png";
import Reel5poster from "../assets/reels/Reel5poster.png";

// Experience / Visual Gallery
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/landing-page-gallery/*.jpg');

// Featured Reels Data (Replace video URLs with your MP4 assets / CDN URLs and add real Instagram links)
const studioReels = [
  {
    id: 'reel-1',
    couple: 'Sushant & Smriti',
    caption: 'Sushant & Smriti ✨ Not just a wedding, a legacy in the making.',
    location: 'Amaravati, Maharashtra, India',
    likes: '42.5K',
    comments: '418',
    shares: '2.1K',
    videoSrc: Reel1,
    poster: Reel1poster,
    instagramUrl: 'https://www.instagram.com/reel/DEDDPnKSqtX/',
    audio: '_gokulphotography • Original audio'
  },
  {
    id: 'reel-2',
    couple: 'Frames of Royalty',
    caption: 'Frames soaked in love, rituals & royalty 👑',
    location: 'Amaravati, Maharashtra, India',
    likes: '28.1K',
    comments: '290',
    shares: '1.4K',
    videoSrc: Reel2,
    poster: Reel2poster,
    instagramUrl: 'https://www.instagram.com/reel/DU5cvM-jOxr/',
    audio: 'Trending Audio • Royal Shehnai'
  },
  {
    id: 'reel-3',
    couple: 'Preserved Forever',
    caption: 'Shot with heart, preserved forever 🤍',
    location: 'Amaravati, Maharashtra, India',
    likes: '54.9K',
    comments: '632',
    shares: '4.8K',
    videoSrc: Reel3,
    poster: Reel3poster,
    instagramUrl: 'https://www.instagram.com/reel/DBtbNpbobU0/',
    audio: '_gokulphotography • Original audio'
  },
  {
    id: 'reel-4',
    couple: 'Meera & Siddharth',
    caption: 'Cinematic bridal entry under the phoolon ki chaadar 🌸',
    location: 'Amaravati, Maharashtra, India',
    likes: '36.8K',
    comments: '354',
    shares: '1.9K',
    videoSrc: Reel4,
    poster: Reel4poster,
    instagramUrl: 'https://www.instagram.com/reel/DeUOu-OMjhq/',
    audio: 'Kudmayi • Instrumental'
  },
  {
    id: 'reel-5',
    couple: 'Tanvi & Harsh',
    caption: 'Subtle promises & intimate vows under the twilight 🌙',
    location: 'Amaravati, Maharashtra, India',
    likes: '19.4K',
    comments: '188',
    shares: '940',
    videoSrc: Reel5,
    poster: Reel5poster,
    instagramUrl: 'https://www.instagram.com/reel/DdoT_6GsGir/',
    audio: '_gokulphotography • Original audio'
  },
];
---

<Layout>
  <!-- Unified Hero + Philosophy Stage (Continuous Crossfade, Zero Black Gap) -->
  <div class="relative w-full bg-[#0a0a0a] overflow-hidden">
    <!-- Continuous Shared Media Background Layer -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <!-- 1. Hero Video: Covers viewport, feather-dissolves at the bottom -->
      <div 
        class="absolute inset-x-0 top-0 h-dvh"
        style="-webkit-mask-image: linear-gradient(to bottom, black 0%, black 65%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, black 65%, transparent 100%);"
      >
        <video
          autoplay
          loop
          muted
          playsinline
          class="w-full h-full object-cover object-center"
        >
          <source src="/hero-video.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
        <!-- Atmospheric tint over video -->
        <div class="absolute inset-0 bg-black/45"></div>
      </div>

      <!-- 2. Philosophy Photo: Begins overlapping inside the bottom of the video for a seamless melt -->
      <div 
        class="absolute inset-x-0 bottom-0 top-[98dvh]"
        style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 30%, black 75%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 75%, transparent 100%);"
      >
        <Image
          src={assets.wedding.Wedding5}
          alt="Wedding Philosophy Atmosphere"
          class="w-full h-full object-cover object-center opacity-30 filter brightness-[0.75] contrast-105"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Hero Content -->
    <section class="relative z-10 min-h-dvh w-full flex items-center justify-center text-center px-4 max-w-4xl mx-auto space-y-6">
      <div class="space-y-6 pt-16">
        <p class="text-xs md:text-sm tracking-[0.35em] text-neutral-300 uppercase font-light drop-shadow">
          Cinematic Wedding Films & Photography
        </p>
       <h1 class="text-3xl sm:text-5xl md:text-4xl font-['Cinzel'] font-light tracking-[0.2em] text-white leading-tight drop-shadow-md">
  Your <span class="font-['Alex_Brush'] text-5xl sm:text-7xl md:text-8xl text-amber-100/90 font-normal capitalize tracking-normal inline-block px-1">love story</span>, framed by Gokul Photography
</h1>
        <div class="pt-4">
          <a
            href="/portfolio/wedding"
            class="group inline-flex items-center gap-3 text-xs tracking-[0.3em] uppercase text-neutral-300 hover:text-white transition-all duration-300 py-2 border-b border-neutral-700/60 hover:border-amber-200/80"
          >
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400/40 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-neutral-400 group-hover:bg-amber-300 transition-colors"></span>
            </span>
            <span>Explore The Gallery</span>
            <span class="transform group-hover:translate-x-1.5 transition-transform duration-300 text-neutral-400 group-hover:text-amber-200">
              &rarr;
            </span>
          </a>
        </div>
      </div>

      <!-- Animated Scroll Down Indicator -->
      <a
        href="#philosophy"
        aria-label="Scroll to content"
        class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 group text-white/70 hover:text-white transition-colors duration-300"
      >
        <span class="text-[10px] tracking-[0.3em] uppercase opacity-75 group-hover:opacity-100 transition-opacity">
          Scroll
        </span>
        <div class="animate-bounce">
          <svg
            class="w-5 h-5 text-white/80"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
      </a>
    </section>

    <!-- Quote & Philosophy Section -->
    <section id="philosophy" class="relative z-10 pt-12 pb-20 sm:pt-16 sm:pb-24 px-6 md:px-12 max-w-4xl mx-auto text-center space-y-8">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-6 bg-amber-200/40"></span>
        <span class="text-xs uppercase tracking-[0.35em] text-neutral-300 font-light">Our Philosophy</span>
        <span class="h-px w-6 bg-amber-200/40"></span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif italic text-white font-light leading-relaxed drop-shadow-md">
        "We call ourselves a collective because we truly believe the best elopements and weddings are a group effort, and that group includes our couples."
      </h2>

      <p class="text-sm sm:text-base text-neutral-300 max-w-2xl mx-auto font-light leading-loose drop-shadow">
        From location and light, to timing and style, our team works together with couples to give them the creative control to envision their day and the guidance to bring that vision to life.
      </p>

      <div class="pt-2 flex justify-center items-center gap-2 text-neutral-500">
        <div class="w-1.5 h-1.5 rotate-45 border border-amber-200/40"></div>
      </div>
    </section>
  </div>

  <!-- ===================================================================== -->
  <!-- Auto-Playing Instagram Reels Section (Horizontal Scrollable Cards)  -->
  <!-- ===================================================================== -->
 
<ReelsCoverflow client:visible studioReels={studioReels} />

  <!-- Category Showcase: Telling Your Story Through Beautiful Imagery -->
  <section class="relative py-28 sm:py-36 px-4 sm:px-8 md:px-12 max-w-7xl mx-auto overflow-hidden">
    <!-- Section Header -->
    <div class="text-center mb-16 sm:mb-20 space-y-4">
      <div class="flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-amber-200/40"></span>
        <span class="text-[10px] tracking-[0.35em] text-neutral-400 uppercase font-light">Curated Collections</span>
        <span class="h-px w-8 bg-amber-200/40"></span>
      </div>

      <h3 class="text-3xl sm:text-4xl md:text-5xl font-serif font-light text-white tracking-wide">
        Telling Your Story Through <span class="italic font-normal text-amber-100/90">Beautiful</span> Imagery
      </h3>

      <p class="text-xs sm:text-sm text-neutral-400 font-light max-w-lg mx-auto leading-relaxed">
        Distinct visual narratives crafted with intention, timeless color palettes, and cinematic depth.
      </p>

      <div class="pt-3 flex justify-center items-center gap-2 text-neutral-600">
        <div class="w-1.5 h-1.5 rotate-45 border border-amber-200/40"></div>
      </div>
    </div>

    <!-- Editorial Two-Column Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {portfolioCategories.map((item, idx) => (
        <a
          href={item.link}
          class="portfolio-showcase-card group relative h-120 sm:h-145 overflow-hidden block bg-neutral-950 border border-neutral-900 shadow-2xl opacity-0 translate-y-16 scale-[0.97] transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform"
          style={`transition-delay: ${idx * 160}ms;`}
        >
          <!-- Image -->
          <Image
            src={item.image}
            alt={item.title}
            width={900}
            height={1200}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-center grayscale-15 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000 ease-out"
          />

          <!-- Gradient Scrim for Content Readability -->
          <div 
            class="absolute inset-0 pointer-events-none transition-opacity duration-500"
            style="background: linear-gradient(to top, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.45) 45%, rgba(10,10,10,0.15) 100%);"
          ></div>

          <!-- Expanding Hairline Accent Border on Hover -->
          <div class="absolute inset-4 sm:inset-6 pointer-events-none border border-amber-200/0 group-hover:border-amber-200/30 transition-all duration-700 scale-95 group-hover:scale-100 z-20"></div>

          <!-- Monospace Index Badge (Top Left) -->
          <div class="absolute top-6 left-6 z-20 flex items-center gap-2">
            <span class="text-[9px] tracking-[0.3em] font-mono text-neutral-300 bg-black/60 backdrop-blur-md px-2.5 py-1 border border-white/10 uppercase">
              № {item.index}
            </span>
          </div>

          <!-- Arrow Pill Icon (Top Right) -->
          <div class="absolute top-6 right-6 z-20 w-9 h-9 rounded-full bg-black/50 backdrop-blur-md border border-white/15 flex items-center justify-center text-white/80 group-hover:bg-amber-100 group-hover:text-black group-hover:border-amber-200 transition-all duration-500 shadow-lg">
            <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
          </div>

          <!-- Content Card Details (Bottom) -->
          <div class="absolute inset-x-0 bottom-0 p-8 sm:p-10 z-20 flex flex-col justify-end space-y-3 transform transition-transform duration-500">
            <div class="w-6 h-px bg-amber-200/60 transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>

            <p class="text-[10px] sm:text-[11px] tracking-[0.3em] uppercase text-neutral-400 font-light">
              {item.subtitle}
            </p>

            <h4 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-white font-light tracking-wide uppercase group-hover:text-amber-100/95 transition-colors">
              {item.title}
            </h4>

            {item.description && (
              <p class="text-xs text-neutral-400 font-light max-w-md line-clamp-2 leading-relaxed opacity-80 group-hover:opacity-100 transition-opacity">
                {item.description}
              </p>
            )}

            <div class="pt-2">
              <span class="inline-flex items-center gap-2 text-[10px] tracking-[0.25em] uppercase text-white/90 group-hover:text-amber-200 transition-colors">
                <span>Explore Series</span>
                <span class="transform group-hover:translate-x-1.5 transition-transform duration-300">&rarr;</span>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Stories Section: The Latest On The Blog/Couples -->
  <section class="py-24 px-6 md:px-12 max-w-7xl mx-auto border-t border-neutral-900">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="space-y-3">
        <span class="text-xs uppercase tracking-[0.3em] text-neutral-400">Journal & Stories</span>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-serif font-light text-white">
          The Latest Stories
        </h3>
      </div>
      <a
        href="/stories"
        class="text-xs uppercase tracking-[0.25em] text-neutral-300 hover:text-white border-b border-neutral-700 hover:border-white pb-1 w-fit transition-colors"
      >
        View All Stories &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {latestStories.map((story) => (
        <article class="group space-y-4">
          <a href={story.link} class="block overflow-hidden h-80 sm:h-96 relative bg-neutral-900 border border-neutral-800/80">
            <Image
              src={story.image}
              alt={story.couple}
              width={800}
              height={600}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-sm px-3 py-1 text-[10px] uppercase tracking-widest text-neutral-200">
              {story.category}
            </div>
          </a>
          <div class="space-y-1">
            <span class="text-[11px] uppercase tracking-[0.2em] text-neutral-500 font-light">
              {story.location}
            </span>
            <h4 class="text-xl font-serif text-neutral-100 group-hover:text-white transition-colors">
              <a href={story.link}>{story.couple}</a>
            </h4>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Featured Films Section -->
  <section class="py-24 px-6 md:px-12 bg-neutral-950/70 border-y border-neutral-900">
    <div class="max-w-7xl mx-auto space-y-16">
      <div class="text-center space-y-3">
        <span class="text-xs uppercase tracking-[0.3em] text-neutral-400">Cinema</span>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-serif font-light text-white">
          From The Films
        </h3>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        {featuredFilms.map((film) => (
          <div class="space-y-6 flex flex-col justify-between">
            <div class="relative aspect-video overflow-hidden border border-neutral-800 bg-neutral-900 pointer-events-none select-none">
              {film.videoId ? (
                <iframe
                  src={`https://www.youtube-nocookie.com/embed/${film.videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${film.videoId}&playsinline=1&rel=0&showinfo=0&modestbranding=1&disablekb=1&fs=0`}
                  title={film.couple}
                  allow="autoplay; encrypted-media; picture-in-picture"
                  tabindex="-1"
                  class="w-full h-full object-cover scale-[1.05]"
                ></iframe>
              ) : (
                <Image
                  src={film.thumbnail}
                  alt={film.couple}
                  class="w-full h-full object-cover"
                  width={800}
                  height={600}
                />
              )}
            </div>

            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <span class="text-xs uppercase tracking-[0.25em] text-neutral-400 font-light">
                  "{film.tag}"
                </span>
                <span class="text-neutral-600">&bull;</span>
                <span class="text-xs uppercase tracking-[0.2em] text-neutral-500">
                  {film.event}
                </span>
              </div>
              <h4 class="text-2xl font-serif text-white font-normal">
                {film.couple}
              </h4>
              <p class="text-sm text-neutral-400 font-light leading-relaxed">
                {film.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Photo Grid Experience -->
  <section class="py-24 px-6 md:px-12 max-w-7xl mx-auto space-y-12">
    <div class="text-center space-y-3">
      <span class="text-xs uppercase tracking-[0.3em] text-neutral-400">Experience</span>
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-serif font-light text-white uppercase tracking-wider">
        A picture is worth a thousand words
      </h3>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {Object.values(images).map(async (imagePromise, index) => {
        const Imageitem = await imagePromise();
        return (
          <div class="overflow-hidden aspect-3/4 bg-neutral-900 border border-neutral-800/80">
            <Image
              width={800}
              height={600}
              src={Imageitem.default}
              alt={`Wedding moment ${index + 1}`}
              loading="lazy"
              class="w-full h-full object-cover hover:scale-110 transition-transform duration-700 ease-out"
            />
          </div>
        );
      })}
    </div>
  </section>

  <!-- Call To Action -->
  <section class="py-24 px-6 md:px-12 text-center bg-linear-to-b from-transparent via-neutral-950/80 to-black border-t border-neutral-900 space-y-8">
    <div class="max-w-3xl mx-auto space-y-6">
      <p class="text-xs uppercase tracking-[0.35em] text-neutral-400">Commitment</p>
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-serif text-white tracking-wide uppercase leading-tight">
        Do. Everything. In Love.
      </h2>
      <p class="text-sm sm:text-base text-neutral-400 max-w-xl mx-auto font-light leading-relaxed">
        Let us preserve your precious, once-in-a-lifetime moments into timeless cinematic films and photographs.
      </p>
      <div class="pt-4">
        <a
          href="/contact"
          class="inline-block border border-white text-white px-10 py-3.5 text-xs tracking-[0.25em] uppercase hover:bg-white hover:text-black transition-all duration-300"
        >
          Inquire Now
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hide scrollbar for standard browsers */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Smooth reveal target state for cards */
  .portfolio-showcase-card.revealed {
    opacity: 1 !important;
    transform: translateY(0) scale(1) !important;
  }
</style>

<script>
  function setupReelsAndInteractions() {
    // 1. Reel Cards Autoplay on Intersection
    const videos = document.querySelectorAll<HTMLVideoElement>('.reel-video');

    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.4 }
    );

    videos.forEach((video) => videoObserver.observe(video));

    // 2. Mute/Unmute Toggles
    const muteButtons = document.querySelectorAll<HTMLButtonElement>('.mute-toggle-btn');
    muteButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest('.reel-card');
        const video = card?.querySelector<HTMLVideoElement>('.reel-video');
        if (!video) return;

        video.muted = !video.muted;

        if (video.muted) {
          btn.innerHTML = `
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
            </svg>
          `;
        } else {
          btn.innerHTML = `
            <svg class="w-3.5 h-3.5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            </svg>
          `;
        }
      });
    });

    // 3. Play/Pause toggle on clicking the card
    const reelCards = document.querySelectorAll<HTMLElement>('.reel-card');
    reelCards.forEach((card) => {
      card.addEventListener('click', (e) => {
        // Prevent action if clicking the mute button or external link
        if ((e.target as HTMLElement).closest('.mute-toggle-btn') || (e.target as HTMLElement).closest('a')) {
          return;
        }

        const video = card.querySelector<HTMLVideoElement>('.reel-video');
        const indicator = card.querySelector<HTMLElement>('.play-state-indicator');
        if (!video) return;

        if (video.paused) {
          video.play();
          if (indicator) {
            indicator.style.opacity = '0';
          }
        } else {
          video.pause();
          if (indicator) {
            indicator.style.opacity = '1';
          }
        }
      });
    });

    // 4. Horizontal Arrow Navigation
    const track = document.getElementById('reelsTrack');
    const prevBtn = document.getElementById('reelsPrevBtn');
    const nextBtn = document.getElementById('reelsNextBtn');

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }

    // 5. Existing Portfolio Scroll Animations
    const cards = document.querySelectorAll<HTMLElement>('.portfolio-showcase-card');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        rootMargin: '0px 0px -50px 0px',
        threshold: 0.12,
      }
    );

    cards.forEach((card) => observer.observe(card));
  }

  setupReelsAndInteractions();
  document.addEventListener('astro:page-load', setupReelsAndInteractions);
</script>