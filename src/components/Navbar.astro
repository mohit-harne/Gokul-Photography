---
interface Props {
  studioName?: string;
}

const { studioName = "IMAGINATION STUDIO" } = Astro.props;

const navLinks = [
  { name: "HOME", href: "/" },
  {
    name: "PORTFOLIO",
    href: "/portfolio",
    dropdown: [
      { name: "WEDDING", href: "/portfolio/wedding" },
      { name: "PRE-WEDDING", href: "/portfolio/pre-wedding" },
    ],
  },
  { name: "STORIES", href: "/stories" },
  { name: "FILMS", href: "/films" },
  { name: "ABOUT US", href: "/about" },
  { name: "FAQ", href: "/faq" },
  { name: "CONTACT", href: "/contact" },
];
---

<header id="site-header" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-5 px-6 md:px-12 bg-transparent text-white">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="text-xl md:text-2xl font-serif tracking-[0.25em] uppercase hover:opacity-80 transition-opacity">
      {studioName}
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center space-x-8 text-xs tracking-[0.2em] font-medium">
      {navLinks.map((item) => (
        item.dropdown ? (
          <div class="relative group py-2">
            <button class="flex items-center space-x-1 hover:text-amber-200 transition-colors uppercase cursor-pointer">
              <span>{item.name}</span>
              <svg class="w-3 h-3 transform group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="absolute left-0 mt-2 w-48 bg-black/90 backdrop-blur-md border border-neutral-800 rounded-sm shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2">
              {item.dropdown.map((subItem) => (
                <a
                  href={subItem.href}
                  class="block px-4 py-2 hover:bg-neutral-800/80 hover:text-amber-200 transition-colors text-[11px]"
                >
                  {subItem.name}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class="hover:text-amber-200 transition-colors py-2 uppercase"
          >
            {item.name}
          </a>
        )
      ))}
    </nav>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="menu-btn"
      type="button"
      class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 focus:outline-none z-50 cursor-pointer"
      aria-label="Toggle Navigation"
    >
      <span class="block w-6 h-0.5 bg-white transition-transform duration-300 origin-center" id="line-top"></span>
      <span class="block w-6 h-0.5 bg-white transition-opacity duration-300" id="line-mid"></span>
      <span class="block w-6 h-0.5 bg-white transition-transform duration-300 origin-center" id="line-bot"></span>
    </button>
  </div>

  <!-- Mobile Drawer Overlay -->
  <div
    id="mobile-drawer"
    class="fixed inset-0 bg-black/95 backdrop-blur-xl flex flex-col justify-center items-center opacity-0 pointer-events-none transition-all duration-300 md:hidden z-40"
  >
    <ul class="flex flex-col items-center space-y-6 text-sm tracking-[0.25em] font-light">
      {navLinks.map((item) => (
        item.dropdown ? (
          <li class="text-center">
            <span class="text-neutral-400 block mb-2">{item.name}</span>
            <div class="flex flex-col space-y-3">
              {item.dropdown.map((subItem) => (
                <a href={subItem.href} class="mobile-link text-white hover:text-amber-200 text-xs">
                  {subItem.name}
                </a>
              ))}
            </div>
          </li>
        ) : (
          <li>
            <a href={item.href} class="mobile-link text-white hover:text-amber-200">
              {item.name}
            </a>
          </li>
        )
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const menuBtn = document.getElementById("menu-btn");
  const mobileDrawer = document.getElementById("mobile-drawer");
  const lineTop = document.getElementById("line-top");
  const lineMid = document.getElementById("line-mid");
  const lineBot = document.getElementById("line-bot");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  // Dynamic Background shift on scroll
  window.addEventListener("scroll", () => {
    if (window.scrollY > 40) {
      header?.classList.add("bg-neutral-950/80", "backdrop-blur-md", "shadow-lg", "py-3.5");
      header?.classList.remove("py-5", "bg-transparent");
    } else {
      header?.classList.remove("bg-neutral-950/80", "backdrop-blur-md", "shadow-lg", "py-3.5");
      header?.classList.add("py-5", "bg-transparent");
    }
  });

  // Mobile Drawer Toggle
  let isOpen = false;
  function toggleMenu() {
    isOpen = !isOpen;
    if (isOpen) {
      mobileDrawer?.classList.remove("opacity-0", "pointer-events-none");
      mobileDrawer?.classList.add("opacity-100", "pointer-events-auto");
      lineTop?.classList.add("rotate-45", "translate-y-2");
      lineMid?.classList.add("opacity-0");
      lineBot?.classList.add("-rotate-45", "-translate-y-2");
      document.body.classList.add("overflow-hidden");
    } else {
      mobileDrawer?.classList.add("opacity-0", "pointer-events-none");
      mobileDrawer?.classList.remove("opacity-100", "pointer-events-auto");
      lineTop?.classList.remove("rotate-45", "translate-y-2");
      lineMid?.classList.remove("opacity-0");
      lineBot?.classList.remove("-rotate-45", "-translate-y-2");
      document.body.classList.remove("overflow-hidden");
    }
  }

  menuBtn?.addEventListener("click", toggleMenu);
  mobileLinks.forEach((link) => link.addEventListener("click", toggleMenu));
</script>