---
interface Props {
  studioName?: string;
  tagline?: string;
}

const { 
  studioName = "GOKUL", 
  tagline = "CINEMATIC VISIONS" 
} = Astro.props;
---

<div id="artistic-preloader" aria-hidden="true">
  <div class="loader-content">
    <span class="loader-title">{studioName}</span>
    <div class="loader-line-track">
      <div class="loader-line-fill"></div>
    </div>
    <span class="loader-tagline">{tagline}</span>
  </div>
</div>

<style is:inline>
  #artistic-preloader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #0a0a0a;
    pointer-events: all;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.65s ease;
  }

  #artistic-preloader.fade-out {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  .loader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 1.5rem;
  }

  .loader-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 300;
    letter-spacing: 0.35em;
    text-indent: 0.35em;
    color: #f5f5f5;
    text-transform: uppercase;
    animation: loaderGlow 2.4s ease-in-out infinite alternate;
  }

  .loader-line-track {
    width: 90px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
    margin: 1.25rem 0 1rem;
    position: relative;
    overflow: hidden;
  }

  .loader-line-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, transparent, #fef08a, transparent);
    animation: lineShimmer 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .loader-tagline {
    font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
    font-size: 0.65rem;
    font-weight: 300;
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    color: #a3a3a3;
    text-transform: uppercase;
  }

  @keyframes lineShimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  @keyframes loaderGlow {
    0% { opacity: 0.85; filter: drop-shadow(0 0 0px rgba(254, 240, 138, 0)); }
    100% { opacity: 1; filter: drop-shadow(0 0 10px rgba(254, 240, 138, 0.25)); }
  }
</style>

<script is:inline>
  (function () {
    const minDisplayTime = 400; // Prevents sudden flashing on ultra-fast cache hits
    let startTime = Date.now();

    function dismissLoader() {
      const loader = document.getElementById('artistic-preloader');
      if (!loader) return;

      const elapsed = Date.now() - startTime;
      const remaining = Math.max(0, minDisplayTime - elapsed);

      setTimeout(() => {
        loader.classList.add('fade-out');
      }, remaining);
    }

    // Dismiss on full load or Astro page navigation
    if (document.readyState === 'complete') {
      dismissLoader();
    } else {
      window.addEventListener('load', dismissLoader, { once: true });
    }

    // Handles Astro ViewTransitions / navigation
    document.addEventListener('astro:page-load', () => {
      dismissLoader();
    });

    // Optional: show briefly during route transitions
    document.addEventListener('astro:before-preparation', () => {
      const loader = document.getElementById('artistic-preloader');
      if (loader) {
        startTime = Date.now();
        loader.classList.remove('fade-out');
      }
    });
  })();
</script>