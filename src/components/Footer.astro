---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-neutral-900 bg-black py-16 px-6 md:px-12 text-neutral-400 text-xs">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 text-left">
    <!-- Brand / Studio Address -->
    <div class="space-y-4">
      <h5 class="text-white text-sm font-serif tracking-widest uppercase">Gokul Studios</h5>
      <p class="font-light leading-relaxed max-w-sm">
        Cinematic wedding films and fine-art photography crafted with heart and authenticity.
      </p>

      <!-- Studio Location -->
      <div class="pt-2 space-y-1 font-light text-neutral-400">
        <p class="text-neutral-200 font-medium flex items-center gap-1.5">
          <span>📍</span> Visit Our Studio
        </p>
        <p class="leading-relaxed">
          Shop No. 1-2-7-8, 1st Floor, "TRADE MARK" Complex,<br />
          Near Gadge Baba Temple, Gadge Nagar,<br />
          Amravati – 444603.
        </p>
      </div>
    </div>

    <!-- Contact Info -->
    <div class="space-y-5">
      <h5 class="text-white text-xs tracking-[0.2em] uppercase font-medium">Contact & Inquiries</h5>

      <!-- Phone Numbers: Stacked on Left, "Phone:" on Right -->
      <div class="flex justify-between items-start gap-4 font-light text-neutral-400 bg-neutral-950/60 border border-neutral-900 p-3.5 rounded-sm">
        <div class="flex flex-col space-y-1.5">
          <span>
            <strong class="text-neutral-300 font-normal">Mangesh Sir:</strong>{" "}
            <a href="tel:+919370157780" class="hover:text-white transition-colors underline-offset-2 hover:underline">
              +91 93701 57780
            </a>
          </span>
          <span>
            <strong class="text-neutral-300 font-normal">Prachi Ma'am:</strong>{" "}
            <a href="tel:+919370157781" class="hover:text-white transition-colors underline-offset-2 hover:underline">
              +91 93701 57781
            </a>
          </span>
        </div>
        <span class="text-neutral-300 font-medium whitespace-nowrap">
          Phone:
        </span>
      </div>

      <!-- Email -->
      <p class="font-light">
        Email: <a href="mailto:contact@gokulstudios.in" class="hover:text-white transition-colors">contact@gokulstudios.in</a>
      </p>

      <!-- Social & Messaging Icons -->
      <div class="pt-2">
        <p class="text-[11px] tracking-wider uppercase text-neutral-500 mb-3">Connect With Us</p>
        <div class="flex items-center gap-4 text-neutral-400">
          <!-- Instagram -->
          <a
            href="https://instagram.com/_gokulphotography"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="hover:text-white transition-colors p-1.5 bg-neutral-900 border border-neutral-800 rounded hover:border-neutral-600"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href="https://www.facebook.com/gokulphotography27"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="hover:text-white transition-colors p-1.5 bg-neutral-900 border border-neutral-800 rounded hover:border-neutral-600"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.595 0 9 1.582 9 4.615V8z"/>
            </svg>
          </a>

          <!-- YouTube -->
          <a
            href="https://youtube.com/@gokul.photography"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="hover:text-white transition-colors p-1.5 bg-neutral-900 border border-neutral-800 rounded hover:border-neutral-600"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>

          <!-- WhatsApp Direct Chat -->
          <a
            href="https://wa.me/919370157780?text=Hi%20Gokul%20Studios,%20I%20would%20like%20to%20inquire%20about%20your%20photography%20services."
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="hover:text-green-400 transition-colors p-1.5 bg-neutral-900 border border-neutral-800 rounded hover:border-neutral-600"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Navigation -->
    <div class="space-y-3 md:text-right">
      <h5 class="text-white text-xs tracking-[0.2em] uppercase font-medium">Quick Links</h5>
      <div class="flex flex-col md:items-end gap-1.5 font-light">
        <a href="/portfolio" class="hover:text-white transition-colors">Portfolio</a>
        <a href="/stories" class="hover:text-white transition-colors">Stories</a>
        <a href="/films" class="hover:text-white transition-colors">Films</a>
        <a href="/contact" class="hover:text-white transition-colors">Bookings</a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-neutral-900 flex flex-col sm:flex-row items-center justify-between text-[11px] text-neutral-500 gap-4">
    <p>&copy; {currentYear} Gokul Studios | All Images and Videos Are Copyrighted.</p>
    <p class="tracking-widest uppercase">Made with passion</p>
  </div>
</footer>