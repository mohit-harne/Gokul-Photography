---

<!-- Responsive Social Bar
     - Mobile: Bottom Center Horizontal Pill
     - Desktop (sm+): Right-Middle Vertical Dock
-->
<aside
  class="fixed z-40 transition-all duration-300
         bottom-5 left-1/2 -translate-x-1/2 flex-row
         sm:bottom-auto sm:left-auto sm:right-5 sm:top-1/2 sm:-translate-y-1/2 sm:translate-x-0 sm:flex-col
         flex items-center"
  aria-label="Social media channels"
>
  <!-- Ambient Indicator Accent (Desktop only) -->
  <div class="hidden sm:block w-[1px] h-5 bg-gradient-to-b from-transparent to-white/15 mb-2"></div>

  <!-- Frosted Blurred Pill Container -->
  <div class="flex sm:flex-col items-center gap-1.5 p-1.5 bg-black/45 backdrop-blur-xl border border-white/10 rounded-full shadow-[0_8px_32px_0_rgba(0,0,0,0.6)]">
    {socials.map((item) => (
      <div class="relative group flex items-center justify-center">
        
        <!-- Tooltip: Pops UP on Mobile, Pops LEFT on Desktop -->
        <span class="absolute pointer-events-none opacity-0 transition-all duration-300 whitespace-nowrap shadow-xl text-[9px] uppercase tracking-[0.25em] text-neutral-200 bg-neutral-950/90 backdrop-blur-md border border-white/10 rounded-full px-2.5 py-1
                     bottom-full mb-2.5 -translate-y-1 group-hover:opacity-100 group-hover:translate-y-0
                     sm:bottom-auto sm:mb-0 sm:right-full sm:mr-3 sm:translate-y-0 sm:translate-x-1 sm:group-hover:translate-x-0">
          {item.name}
        </span>

        <!-- Icon Link with smooth rounded hit-area and vibrant hover dynamics -->
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.name}
          class={`relative flex items-center justify-center w-9 h-9 rounded-full border border-transparent transition-all duration-300 hover:scale-105 active:scale-95 ${item.hoverBg} ${item.hoverBorder}`}
        >
          <span class="relative z-10 flex items-center justify-center" set:html={item.icon} />
        </a>
      </div>
    ))}
  </div>

  <!-- Ambient Indicator Accent (Desktop only) -->
  <div class="hidden sm:block w-[1px] h-5 bg-gradient-to-b from-white/15 to-transparent mt-2"></div>
</aside>