            <stop offset="100%" stop-color="#285AEB" />
          </linearGradient>
        </defs>
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke="url(#ig-grad)" stroke-width="1.8"></rect>
        <circle cx="12" cy="12" r="4.2" stroke="url(#ig-grad)" stroke-width="1.8"></circle>
        <circle cx="17.5" cy="6.5" r="1.1" fill="url(#ig-grad)"></circle>
