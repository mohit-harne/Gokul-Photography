---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SocialDock  from '../components/SocialDock.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Gokul Photography Studio | Cinematic Wedding Films & Photography",
  description = "Telling your story through beautiful and meaningful imagery."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#0a0a0a] text-[#f5f5f5]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/letter-g.png" />

    <!-- Instant Critical CSS (Runs before CDN scripts download) -->
    <style is:inline>
      html, body {
        background-color: #0a0a0a !important;
        color: #f5f5f5 !important;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        font-family: 'Montserrat', system-ui, -apple-system, sans-serif;
      }
      /* Prevent video flicker & keep overlays sharp immediately */
      video {
        display: block;
      }
    </style>

    <!-- Google Fonts with display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Montserrat:wght@200;300;400;500&family=Playfair+Display:ital,wght@0,400;1,400&family=Alex+Brush&display=swap" rel="stylesheet">

    <!-- Tailwind CDN with is:inline -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
              sans: ['Montserrat', 'sans-serif'],
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-neutral-950 text-neutral-100 font-sans antialiased selection:bg-neutral-800 selection:text-amber-100 min-h-screen">
    <Navbar />
    <SocialDock/>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  h1, h2, h3, .font-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  body, .font-sans {
    font-family: 'Montserrat', sans-serif;
  }
</style>